  "repository": {
    "type": "git",
    "url": "git+https://github.com/anh-chu/pi-statusbar-control.git"
  },
  "homepage": "https://github.com/anh-chu/pi-statusbar-control",
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
